# Kite network: testnet | mainnet (or a CAIP-2 id like eip155:2368)
KITE_NETWORK=testnet

# Your receiving wallet address (EVM, 0x...). NO private key goes here.
PAY_TO=0x0000000000000000000000000000000000000000

# Minimum price in token units (USD-pegged). e.g. 0.001
PRICE_USD=0.001

# Kite x402 facilitator base URL — must end with /v2. Verify against official docs for production.
FACILITATOR_URL=https://facilitator.pieverse.io/v2

# HTTP service port
PORT=8080

# Optional service description surfaced in /.well-known/x402
SERVICE_DESCRIPTION=Premium API call
